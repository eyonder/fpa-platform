// FP&A Platform — Prisma şeması.
//
// Bu şema `fpa-postgres-prisma-rls-guide.md`'deki taslaktan UYARLANMIŞTIR,
// birebir kopyalanmamıştır: gerçek uygulamanın `src/shared/types/*.ts`
// altındaki tipleriyle birebir eşleşecek şekilde tasarlanmıştır (örn. bu
// uygulamada bir Organization ZATEN bir tenant'tır — ayrı bir OrganizationNode
// yoktur; BudgetLine ay-başına-satır modelindedir, m1..m12 geniş kolon
// modelinde DEĞİL; User değil Membership tenant taşır — bir kullanıcının
// birden çok tenant'ta üyeliği olabilir).
//
// RLS (satır düzeyinde güvenlik) sadece GERÇEKTEN tenant'a bölünmüş
// tablolarda aktiftir: Scenario, BudgetLine, AuditLog, ImportJob (bkz.
// prisma/migrations/*_enable_rls/migration.sql). User/Membership/Session/
// PasswordResetToken (kimlik çözümleme, tenant bilinmeden ÖNCE sorgulanır)
// ve Tenant/FxRate/BudgetCategory (küresel referans verisi) BİLEREK RLS
// dışında tutulmuştur.

// Prisma 7: bağlantı URL'i artık burada değil, `prisma.config.ts` +
// runtime'da `backend/core/prisma-client.ts` içindeki driver adapter
// (`@prisma/adapter-pg`) üzerinden geçirilir (bkz. https://pris.ly/d/config-datasource).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Tenant (= Organization). Holding ağacı için öz-ilişki.
// ----------------------------------------------------

model Tenant {
  id             String  @id
  name           String
  parentTenantId String?
  baseCurrency   String

  parent   Tenant?  @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  children Tenant[] @relation("TenantHierarchy")

  memberships            Membership[]
  scenarios              Scenario[]
  budgetLines            BudgetLine[]
  auditLogs              AuditLog[]
  importJobs             ImportJob[]
  sessions               Session[]
  employees              Employee[]
  employeeCompensations  EmployeeCompensation[]
  costCenters            CostCenter[]
  allocationKeys         AllocationKey[]
  allocationKeyMembers   AllocationKeyMember[]
  expenseEntries         ExpenseEntry[]
  fixedAssets            FixedAsset[]
  salesOpportunities     SalesOpportunity[]
  salesBillingMilestones SalesBillingMilestone[]
  cashFlowEvents         CashFlowEvent[]
  mappingConfigs         MappingConfig[]
  bankBalances           BankBalance[]
  bankTransactions       BankTransaction[]

  @@index([parentTenantId])
}

// ----------------------------------------------------
// 2. Kullanıcılar, çoklu-tenant üyelik (RBAC rolü üyelik başınadır)
// ----------------------------------------------------

enum Role {
  ADMIN
  BUDGET_MANAGER
  DATA_ENTRY
}

model User {
  id           String @id
  name         String
  email        String @unique
  passwordHash String

  // TOTP MFA — bkz. backend/modules/auth/mfa.service.ts. Sır (secret) ASLA
  // düz metin saklanmaz, backend/core/crypto.ts ile şifrelenir. mfaEnabled
  // false iken bir mfaSecretCiphertext dolu olabilir (yarım kalmış/henüz
  // onaylanmamış kayıt) — login akışı SADECE mfaEnabled'a bakar, bu yüzden
  // güvenlidir.
  mfaSecretCiphertext String?
  mfaEnabled          Boolean @default(false)

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaBackupCodes      MfaBackupCode[]
  mfaChallenges       MfaChallenge[]
}

model MfaBackupCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Şifre doğrulandı, oturum HENÜZ kurulmadı — bkz. auth.service.ts login().
 */
model MfaChallenge {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  // Yalnızca dahili sıralama içindir (bkz. findMembershipsByUser) — domain
  // tipinde (Membership) YOKTUR, API yanıtına asla sızmaz. Seed script'i
  // bugünkü sabit dizi sırasını birebir korumalı: authService.login()
  // "ilk üyelik = birincil tenant" mantığını hâlâ kullanıyor.
  id Int @default(autoincrement())

  userId   String
  tenantId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// ----------------------------------------------------
// 3. Oturum & şifre sıfırlama (RLS YOK — tenant bilinmeden önce sorgulanır)
// ----------------------------------------------------

model Session {
  id        String   @id
  userId    String
  tenantId  String
  createdAt DateTime
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  token     String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------
// 4. Senaryolar (RLS'li)
// ----------------------------------------------------

enum ScenarioKind {
  BUDGET
  ACTUAL
  FORECAST
}

model Scenario {
  id           String       @id
  tenantId     String
  name         String
  kind         ScenarioKind
  fiscalYear   Int
  isLocked     Boolean      @default(false)
  baseCurrency String
  updatedAt    DateTime     @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetLines    BudgetLine[]
  auditLogs      AuditLog[]
  importJobs     ImportJob[]
  expenseEntries ExpenseEntry[]

  // Treasury: bir Scenario iki farklı ilişkiyle CashFlowEvent'e bağlanabilir
  // (nakit tarafı VE yumuşak tahakkuk referansı) — bkz. 14. bölüm notu.
  cashFlowEvents        CashFlowEvent[] @relation("TreasuryEventScenario")
  accrualCashFlowEvents CashFlowEvent[] @relation("TreasuryEventAccrualScenario")

  @@index([tenantId, name])
}

// ----------------------------------------------------
// 5. Bütçe kategorileri (küresel referans — RLS YOK, bugünkü davranışla aynı)
// ----------------------------------------------------

enum BudgetCategoryType {
  INCOME
  EXPENSE
}

model BudgetCategory {
  id        String             @id
  name      String
  type      BudgetCategoryType
  sortOrder Int

  budgetLines    BudgetLine[]
  auditLogs      AuditLog[]
  expenseEntries ExpenseEntry[]
  cashFlowEvents CashFlowEvent[]
  mappingConfigs MappingConfig[]
}

// ----------------------------------------------------
// 6. Bütçe satırları (RLS'li) — ay-başına-satır, m1..m12 geniş kolon DEĞİL
// ----------------------------------------------------

model BudgetLine {
  scenarioId String
  categoryId String
  month      Int

  // Denormalize: domain tipinde (BudgetLine) yok, sadece RLS + index için.
  // Repository sınırında dışa asla sızdırılmaz.
  tenantId String

  // Kuruş (integer minor unit) — shared/lib/money.ts'teki
  // toMinorUnits/fromMinorUnits ile repository sınırında çevrilir.
  amountMinor BigInt

  updatedAt DateTime @updatedAt

  scenario Scenario       @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [categoryId], references: [id])
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([scenarioId, categoryId, month])
  @@index([tenantId])
}

// ----------------------------------------------------
// 7. Denetim izi (RLS'li — sadece SELECT+INSERT, UPDATE/DELETE politikası YOK)
// ----------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
}

enum AuditSource {
  MANUAL_EDIT
  FORECAST
  IMPORT
  PAYROLL
  EXPENSE
  DEPRECIATION
  SALES
}

model AuditLog {
  // audit.service.ts crypto.randomUUID() ile üretip geçirir — @default YOK.
  id       String @id
  tenantId String
  userId   String
  userName String

  action     AuditAction
  entityType String // şimdilik hep "BudgetLine"
  scenarioId String
  categoryId String
  month      Int
  fieldName  String // şimdilik hep "amount"

  // Kuruş (integer minor unit) — BudgetLine.amountMinor ile aynı disiplin.
  oldValue BigInt
  newValue BigInt

  occurredAt DateTime
  source     AuditSource

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario Scenario       @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  category BudgetCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId, scenarioId])
}

// ----------------------------------------------------
// 8. İçe aktarma sihirbazı (RLS'li)
// ----------------------------------------------------

enum ImportStatus {
  PENDING_REVIEW
  COMMITTED
}

model ImportJob {
  id         String       @id
  tenantId   String
  scenarioId String
  fileName   String
  status     ImportStatus @default(PENDING_REVIEW)

  detectedColumns  Json
  suggestedMapping Json
  appliedMapping   Json
  rows             Json
  issues           Json

  // {headers, rows} — commit sonrası Prisma.JsonNull ile temizlenir
  // (eski deleteRawGrid davranışının karşılığı).
  rawGrid Json?

  createdAt         DateTime
  createdByUserId   String
  createdByUserName String
  committedAt       DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ----------------------------------------------------
// 9. Döviz kurları (küresel referans — RLS YOK)
// ----------------------------------------------------

model FxRate {
  date  DateTime @db.Date
  base  String
  quote String
  rate  Float

  @@id([date, base, quote])
}

// ----------------------------------------------------
// 10. Personel / Bordro (Faz 2.1)
// ----------------------------------------------------
// Employee/EmployeeCompensation RLS'lidir (Scenario/BudgetLine/AuditLog/
// ImportJob setine katılır) — maaş verisi tenant'a özeldir. PayrollTaxConfig
// KÜRESEL referans (FxRate/BudgetCategory gibi, RLS YOK) — vergi mevzuatı
// her tenant için aynıdır. `payroll:read`/`payroll:write` izinleri SADECE
// ADMIN'e verilir (backend/core/authorize.ts) — BUDGET_MANAGER bile maaş
// verisini GÖREMEZ; bu, uygulamadaki ilk gerçek ADMIN/BUDGET_MANAGER
// ayrımıdır (bkz. roadmap: "sadece yetkili (HR/Admin) tarafından görülmesini
// sağlayan RLS ve özel şifreleme katmanı").

enum DisabilityDegree {
  NONE
  DEGREE_1 // %80+ — en yüksek indirim
  DEGREE_2 // %60-79
  DEGREE_3 // %40-59
}

enum CompensationInputMode {
  GROSS_FIXED
  NET_FIXED
}

model Employee {
  id       String @id
  tenantId String

  fullName        String
  position        String
  department      String?
  hireDate        DateTime
  terminationDate DateTime?
  isActive        Boolean   @default(true)

  // Vergi/SGK hesabını doğrudan etkileyen nitelikler — bkz.
  // payroll-calculator.ts. Emekli (SGDP) işsizlik sigortasından MUAFTIR ve
  // farklı SGK oranına tabidir; kapıcı gelir/damga vergisinden TAM MUAFTIR
  // (sadece SGK kesilir); engellilik derecesi aylık vergi matrahından sabit
  // bir tutar düşürür.
  isRetired        Boolean          @default(false)
  isConcierge      Boolean          @default(false)
  disabilityDegree DisabilityDegree @default(NONE)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  compensations EmployeeCompensation[]

  @@index([tenantId])
}

model EmployeeCompensation {
  id            String   @id
  employeeId    String
  tenantId      String
  effectiveFrom DateTime

  inputMode CompensationInputMode

  // Tutar (kuruş) burada DEĞİL — backend/core/crypto.ts (AES-256-GCM) ile
  // şifreli JSON olarak saklanır (bkz. mfa.repository.ts'teki aynı desen):
  // {"amountMinor": "...", "mealAllowanceDays": 20, "transportAllowanceDays": 20,
  //  "plannedOvertimeHoursPerMonth": 0, "applyEmployerIncentive": false}
  // RLS + bu şifreleme katmanı birlikte, roadmap'in "özel şifreleme
  // katmanı" gereksinimini karşılar.
  compensationCiphertext String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([tenantId])
}

/**
 * Küresel, düzenlenebilir vergi/SGK parametre tablosu — mali yıl başına BİR
 * kayıt. Değerler KOD İÇİNE gömülmez (fx-rate.repository.ts'teki "sabit demo
 * kur tablosu" felsefesiyle aynı): yasa her yıl değişir, bu bir veri
 * güncellemesi olmalı, kod değişikliği değil. RLS YOK (bkz. dosya başı not).
 */
model PayrollTaxConfig {
  fiscalYear Int @id

  minimumWageGrossMonthlyMinor BigInt // Aylık brüt asgari ücret
  sgkCeilingMinor              BigInt // SGK tavan (asgari ücretin 9 katı)

  severanceCeilingH1Minor BigInt // Kıdem tazminatı tavanı (Ocak-Haziran) — bkz. dosya başı not: hesaplamada KULLANILMIYOR, ileri kullanım için saklanıyor
  severanceCeilingH2Minor BigInt // (Temmuz-Aralık)

  // Günlük istisna tutarları — bkz. payroll-calculator.ts'teki varsayım notu
  // (tam olarak istisna tavanında ödendiği varsayılır).
  dailyMealAllowanceExemptMinor      BigInt
  dailyTransportAllowanceExemptMinor BigInt

  // Standart çalışan oranları.
  employeeSgkRate          Decimal @db.Decimal(6, 4) // 0.1400
  employeeUnemploymentRate Decimal @db.Decimal(6, 4) // 0.0100
  employerSgkRate          Decimal @db.Decimal(6, 4) // 0.2175 (teşviksiz)
  employerSgkIncentiveRate Decimal @db.Decimal(6, 4) // 0.0500 (teşvik puanı — 0.2175'ten düşülür)
  employerUnemploymentRate Decimal @db.Decimal(6, 4) // 0.0200

  // Emekli (SGDP) oranları — işsizlik sigortası YOK.
  retiredEmployeeSgdpRate Decimal @db.Decimal(6, 4) // 0.0750
  retiredEmployerSgdpRate Decimal @db.Decimal(6, 4) // 0.2450 (SGDP + kısa vadeli sigorta kolları dahil)

  // Kümülatif gelir vergisi dilimleri — [{uptoAnnualMinor: string|null, rate: number}],
  // artan sırada, SON eleman uptoAnnualMinor:null (üst sınırsız dilim).
  incomeTaxBrackets Json

  stampDutyRate Decimal @db.Decimal(6, 5) // 0.00759

  // Asgari ücret istisnası — sabit aylık tavan, hesaplanan vergiden düşülür.
  minimumWageIncomeTaxExemptionMonthlyMinor BigInt
  minimumWageStampTaxExemptionMonthlyMinor  BigInt

  // Engellilik indirimi — aylık matrahtan düşülen SABİT tutar (dereceye göre).
  disabilityDeductionDegree1Minor BigInt
  disabilityDeductionDegree2Minor BigInt
  disabilityDeductionDegree3Minor BigInt

  standardMonthlyWorkingHours Int     @default(225)
  overtimePremiumMultiplier   Decimal @default(1.5) @db.Decimal(4, 2)
}

// ----------------------------------------------------
// 11. Gider Merkezleri / Onay Akışı (Faz 2.2)
// ----------------------------------------------------
// CostCenter/AllocationKey/AllocationKeyMember/ExpenseEntry RLS'lidir
// (Scenario/BudgetLine/AuditLog/ImportJob/Employee setine katılır) —
// tenant'a özel veridir. "Gider türü" için AYRI bir model YOK — mevcut
// BudgetCategory (type: EXPENSE) doğrudan kullanılır, çünkü ExpenseEntry
// sonunda budgetLineService.bulkUpsert üzerinden zaten BudgetCategory
// eksenli BudgetLine'a yazılır (bkz. expense-entry.service.ts).
//
// AllocationKey: bir KAYNAK gider merkezinin (ör. paylaşılan BT hizmeti)
// maliyetini üye gider merkezlerine SABİT % ağırlıkla dağıtır. Bu dağılım
// SADECE raporlama/iç yükleme (cross-charge) amaçlıdır — BudgetLine'da
// gider merkezi ekseni YOKTUR, o yüzden dağılım booked kategori/ay
// toplamını DEĞİŞTİRMEZ (bkz. expense-allocation.ts).

model CostCenter {
  id                 String  @id
  tenantId           String
  code               String
  name               String
  parentCostCenterId String?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   CostCenter?  @relation("CostCenterHierarchy", fields: [parentCostCenterId], references: [id])
  children CostCenter[] @relation("CostCenterHierarchy")

  allocationKey     AllocationKey?        @relation("AllocationKeySource")
  allocatedAsMember AllocationKeyMember[]
  expenseEntries    ExpenseEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, parentCostCenterId])
}

// Bir kaynak gider merkezinin maliyetini üye gider merkezlerine sabit %
// ağırlıkla dağıtan anahtar. EN FAZLA bir anahtar/kaynak gider merkezi
// (bkz. @@unique). ExpenseEntry bu anahtara DOĞRUDAN referans VERMEZ —
// rapor, entry.costCenterId üzerinden anahtarı arar (expense-allocation.ts).
model AllocationKey {
  id                 String @id
  tenantId           String
  name               String
  // `@unique` (küresel, tenantId'ye bağlı DEĞİL): id'ler zaten UUID olduğu
  // için pratikte fark etmez, ama Prisma bire-bir ilişkinin (CostCenter.allocationKey)
  // tanımlı tarafında salt bir `@unique` alan İSTER (composite unique yetmez).
  sourceCostCenterId String @unique

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceCostCenter CostCenter            @relation("AllocationKeySource", fields: [sourceCostCenterId], references: [id], onDelete: Cascade)
  members          AllocationKeyMember[]
}

model AllocationKeyMember {
  id              String  @id
  tenantId        String
  allocationKeyId String
  costCenterId    String
  // Yüzde ağırlık (0-100) — bir anahtarın üyeleri toplamda 100 etmeli
  // (service katmanında doğrulanır, DB constraint YOK).
  weightPercent   Decimal @db.Decimal(5, 2)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocationKey AllocationKey @relation(fields: [allocationKeyId], references: [id], onDelete: Cascade)
  costCenter    CostCenter    @relation(fields: [costCenterId], references: [id])

  @@unique([allocationKeyId, costCenterId])
  @@index([tenantId])
}

enum ExpenseEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  COMMITTED
}

model ExpenseEntry {
  id           String @id
  tenantId     String
  scenarioId   String
  costCenterId String
  categoryId   String
  month        Int

  // Kuruş (integer minor unit) — BudgetLine.amountMinor ile aynı disiplin.
  amountMinor BigInt

  status ExpenseEntryStatus @default(DRAFT)

  submittedByUserId   String?
  submittedByUserName String?
  submittedAt         DateTime?

  decidedByUserId   String?
  decidedByUserName String?
  decidedAt         DateTime?
  rejectionReason   String?

  // commitApproved'da APPROVED -> COMMITTED geçişiyle birlikte set edilir
  // (bkz. expense-entry.service.ts) — budgetLineService.bulkUpsert'in
  // ürettiği AuditLog'dan AYRI, bu entry'nin KENDİ durumunu izler.
  committedAt DateTime?

  createdAt DateTime
  updatedAt DateTime @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario   Scenario       @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  costCenter CostCenter     @relation(fields: [costCenterId], references: [id])
  category   BudgetCategory @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, scenarioId, costCenterId, categoryId, month])
  @@index([tenantId, scenarioId, status])
  @@index([tenantId, costCenterId])
}

// ----------------------------------------------------
// 12. Sabit Kıymetler / Amortisman (Faz 2.3)
// ----------------------------------------------------
// v1 SADECE VUK/TDHP kapsar — tek gerçek devlet-oranlı (rate-table) standart.
// UFRS/SPK/USGAAP prensip bazlıdır (şirket kendi faydalı ömrünü seçer,
// resmi oran tablosu YOK) ve bilerek ERTELENMİŞTİR.
//
// ExpenseEntry'nin AKSİNE FixedAsset'te COMMITTED durumu YOKTUR: bir
// varlığın amortismanı BİRDEN ÇOK mali yıla (Scenario'ya) yayılır, tek bir
// "commit anı" yoktur. Onay akışı DRAFT/REJECTED -> SUBMITTED -> APPROVED/
// REJECTED'te durur; bütçeye yazma AYRI, senaryo bazlı, TEKRAR ÇALIŞTIRILABİLİR
// bir eylemdir (depreciation.service.ts#previewForScenario/commitForScenario)
// — payroll.service.ts'teki preview/commitToBudget'ın (ara durum saklamadan
// HER SEFERİNDE yeniden hesaplama) AYNI disiplini, ExpenseEntry'nin tek
// seferlik commit'i DEĞİL.

enum FixedAssetCategory {
  BUILDINGS
  MACHINERY_EQUIPMENT
  VEHICLES
  FURNITURE_FIXTURES
  COMPUTER_HARDWARE
  LEASEHOLD_IMPROVEMENTS
}

// Küresel referans (PayrollTaxConfig gibi) — RLS YOK, VUK oranları her
// tenant için aynı yasal mevzuattır. Doğal anahtar: category. Kullanıcının
// SAĞLADIĞI resmi VUK oranları (bkz. seed.ts#seedVukAmortismanConfig) —
// kod içine gömülmez, payroll'daki "config veri, kod değil" felsefesiyle aynı.
model VukAmortismanConfig {
  category        FixedAssetCategory @id
  usefulLifeYears Int
  annualRate      Decimal            @db.Decimal(6, 4)
  vukReference    String
}

enum FixedAssetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Surrogate id (ExpenseEntry ile AYNI gerekçe: bağımsız bir onay akışı durum
// makinesi var). Amortisman programı (schedule) AYRI bir tabloda SAKLANMAZ —
// depreciation-schedule.ts saf fonksiyonu bu satırın alanlarından
// (baseValueMinor, category/override, acquisitionDate) HER İSTEKTE YENİDEN
// üretir — payroll preview'daki "recompute, don't persist" disipliniyle aynı.
model FixedAsset {
  id       String @id
  tenantId String

  assetName       String
  category        FixedAssetCategory
  acquisitionDate DateTime           @db.Date
  baseValueMinor  BigInt

  // SADECE LEASEHOLD_IMPROVEMENTS için anlamlıdır — diğer beş kategorinin
  // oranı doğrudan yasal zorunluluktur, iş takdirine YER YOK; servis
  // katmanında diğer kategoriler için reddedilir (bkz. fixed-asset.service.ts).
  usefulLifeYearsOverride Int?

  // NPV/IRR girdileri — HER istekte yeniden hesaplanır, asla saklanmaz (bkz.
  // npv-irr.ts). [{"year":1,"amountMinor":...}, ...], yıl 1'den başlar; yıl 0
  // (ilk yatırım, -baseValueMinor) hesaplama sırasında otomatik eklenir.
  cashFlowProjectionMinor Json
  discountRate            Decimal @db.Decimal(6, 4)

  description String?
  status      FixedAssetStatus @default(DRAFT)

  submittedByUserId   String?
  submittedByUserName String?
  submittedAt         DateTime?

  decidedByUserId   String?
  decidedByUserName String?
  decidedAt         DateTime?
  rejectionReason   String?

  createdAt DateTime
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, category])
}

// ----------------------------------------------------
// 13. Satış Fırsatları (Sales Pipeline) — RLS'li (Faz 3.1)
// ----------------------------------------------------
// FixedAsset'in AKSİNE: burada bir onay akışı durum makinesi YOK — canlı bir
// CRM kaydı. Tek korumalı geçiş: LEAD/QUALIFIED/PROPOSAL/NEGOTIATION (açık)
// -> WON/LOST (kapalı), SADECE POST /api/sales-opportunities/:id/close ile
// (bkz. sales-opportunity.service.ts). İki BAĞIMSIZ bütçeye yazma yolu var
// (sales-forecast.service.ts): WON'ların closedAt ayına TAM expectedValue'su
// (actuals) ve AÇIK fırsatların expectedCloseDate ayına
// expectedValue*winProbability'si (pipeline forecast) — HER İKİSİ de
// budgetLineService.bulkUpsert ile (kaynak: SALES) "Gelir" (cat-gelir)
// kategorisine yazılır; kilit kontrolü ve audit kaydı oradan otomatik gelir.
// Kod bu ikisinin FARKLI senaryolara yazılmasını ZORUNLU KILMAZ — bkz.
// SalesActualsPostPanel/SalesPipelineForecastPostPanel'deki uyarı metni.

enum SalesOpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// Küresel referans (VukAmortismanConfig ile AYNI desen) — RLS YOK, doğal
// anahtar: stage. Varsayılan kazanma olasılıkları iş politikasıdır (VUK/SGK
// gibi yasal zorunluluk DEĞİL) — bkz. seed.ts#seedSalesStageConfig. Her
// fırsatta winProbabilityOverride ile (HERHANGİ bir aşamada, FixedAsset'in
// leasehold-only override kısıtının AKSİNE) geçersiz kılınabilir.
model SalesStageConfig {
  stage                 SalesOpportunityStage @id
  defaultWinProbability Decimal               @db.Decimal(6, 4)
}

// Surrogate id. Onay akışı YOK (bkz. dosya başı notu) — closedAt/closedBy*
// SADECE `close` uç noktasından set edilir.
model SalesOpportunity {
  id       String @id
  tenantId String

  customerName       String
  dealName           String
  expectedValueMinor BigInt
  expectedCloseDate  DateTime              @db.Date
  stage              SalesOpportunityStage @default(LEAD)

  // Herhangi bir aşamada geçerlidir (bkz. dosya başı notu).
  winProbabilityOverride Decimal? @db.Decimal(6, 4)

  // NULL = açık. Dolu = WON ya da LOST'a kapatılmış, GERÇEK kapanış ayı
  // (expectedCloseDate'ten BAĞIMSIZ) — actuals commit bunu kullanır.
  closedAt         DateTime? @db.Date
  closedByUserId   String?
  closedByUserName String?

  createdAt DateTime
  updatedAt DateTime @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingMilestones SalesBillingMilestone[]

  @@index([tenantId, stage])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, closedAt])
}

// Bir WON fırsatın "hakediş faturalama tarihleri" (progress/milestone billing
// takvimi). AllocationKeyMember İLE AYNI desen: kendi (denormalize) tenantId
// kolonu var (RLS + index için, parent ilişkisinden bağımsız); tutarlar
// toplamda fırsatın expectedValue'suna eşit olmalı — DB constraint YOK,
// AllocationKeyMember'ın sabit %100 hedefinin AKSİNE bu fırsata özgü
// (DB'den okunan) bir hedef olduğu için Zod `.refine()` ile ifade EDİLEMEZ,
// servis katmanında doğrulanır (bkz. sales-opportunity.service.ts). En az
// bir milestone olmadan bir fırsat WON'a kapatılamaz (bkz. close()).
model SalesBillingMilestone {
  id                 String @id
  tenantId           String
  salesOpportunityId String

  billingDate DateTime @db.Date
  amountMinor BigInt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOpportunity SalesOpportunity @relation(fields: [salesOpportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesOpportunityId])
}

// ----------------------------------------------------
// 14. Hazine (Treasury) — günlük hassasiyetli nakit defteri (RLS'li, Faz 4.1)
//
// BudgetLine'dan BAĞIMSIZ bir defterdir. BudgetLine ay bazlı ve TAHAKKUK
// (accrual) mantığındadır; CashFlowEvent gün bazlı ve NAKİT (cash)
// mantığındadır. İkisi arasında YUMUŞAK bir referans vardır
// (accrualScenarioId + accrualStartMonth), FK YOKTUR — işaret edilen
// BudgetLine satırı hiç var olmayabilir, bu geçerlidir. Bu KASITLI bir
// mimari karar: BudgetLine altı modülün (Payroll/FixedAsset/Sales/Import/
// Expense) tek yazma noktasıdır (budgetLineService.bulkUpsert) — Treasury
// ona HİÇ dokunmaz, ayrı bir defter olarak yaşar.
// ----------------------------------------------------

enum CashFlowDirection {
  INFLOW // tahsilat
  OUTFLOW // ödeme
}

enum CashFlowEventStatus {
  PLANNED // projeksiyona dahil
  NEUTRALIZED // gerçek banka hareketiyle eşleşti — projeksiyondan DÜŞÜLÜR
  CANCELLED // iptal — hiçbir hesaba katılmaz
}

enum CashFlowEventSource {
  MANUAL // elle giriş / grid içi düzenleme / Excel'den yapıştırma
  THP_IMPORT // Tek Düzen Hesap Planı Excel içe aktarımı (Faz 4.2)
}

// THP hesabının hangi katmana ait olduğu. 120/320 gibi BİLANÇO hesapları
// gerçek vade taşır -> nakit olayı üretir. 600/770 gibi GELİR TABLOSU
// hesapları tahakkuktur -> nakit olayı ÜRETMEZ (üretirse çift sayılır).
// Faz 4.1'de şemaya EKLENDİ ama Faz 4.2'ye kadar tüketilmedi — bilinçli:
// sonradan eklemek geri dönük veri düzeltmesi (backfill) gerektirirdi.
enum MappingLayer {
  CASH
  ACCRUAL
}

model CashFlowEvent {
  id         String @id
  tenantId   String
  scenarioId String

  // --- NAKİT KATMANI (gün hassasiyeti) ---
  dueDate     DateTime          @db.Date // paranın bankaya girdiği/çıktığı gün
  direction   CashFlowDirection
  amountMinor BigInt // HER ZAMAN pozitif; işareti direction taşır

  status CashFlowEventStatus @default(PLANNED)
  source CashFlowEventSource @default(MANUAL)

  // --- TAHAKKUK KATMANI (BudgetLine'a YUMUŞAK referans, FK YOK) ---
  // accrualScenarioId genelde scenarioId ile aynıdır ama 90 günlük pencere
  // mali yıl sınırını aşabildiği için AYRI bir alandır (bir sonraki yılın
  // senaryosuna işaret edebilir).
  accrualScenarioId   String?
  accrualStartMonth   Int? // 1..12
  accrualSpreadMonths Int     @default(1) // 12 = yıla yayılan hizmet bedeli

  categoryId String // BudgetCategory (GLOBAL tablo, RLS yok)

  counterparty String?
  description  String?

  // Provenance (Faz 4.2'de dolar)
  thpAccountCode  String?
  mappingConfigId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenario        Scenario       @relation("TreasuryEventScenario", fields: [scenarioId], references: [id], onDelete: Cascade)
  accrualScenario Scenario?      @relation("TreasuryEventAccrualScenario", fields: [accrualScenarioId], references: [id], onDelete: SetNull)
  category        BudgetCategory @relation(fields: [categoryId], references: [id])
  mappingConfig   MappingConfig? @relation(fields: [mappingConfigId], references: [id], onDelete: SetNull)

  // Ters ilişki — FK BankTransaction tarafındadır (bkz. o modeldeki not).
  matchedTransaction BankTransaction?

  @@index([tenantId])
  @@index([scenarioId, dueDate]) // projeksiyonun sıcak yolu
  @@index([scenarioId, status])
  @@index([categoryId])
  @@index([mappingConfigId])
}

// THP (Tek Düzen Hesap Planı) kodu -> BudgetCategory eşleştirme kuralı.
// TENANT'A ÖZELDİR (RLS'li), BudgetCategory gibi global DEĞİLDİR: THP bir
// ulusal standart ama alt hesap kullanımı (120.01.xxx) şirkete özeldir ve
// hangi kategoriye eşleneceği şirket politikasıdır — global olsaydı bir
// tenant'ın hesap planı diğerine sızardı (gerçek bir izolasyon kusuru).
model MappingConfig {
  id       String @id
  tenantId String

  accountCode String // "120", "320.01", "770" — ÖNEK olarak eşleşir (en uzun önek kazanır)
  accountName String // insan okunur etiket ("Alıcılar")

  categoryId String
  direction  CashFlowDirection
  layer      MappingLayer      @default(CASH)

  // Excel'de "Vade Tarihi" boşsa: belge tarihi + defaultTermDays.
  // null ise vadesiz kabul edilir ve satır "eksik vade" olarak raporlanır.
  defaultTermDays Int?

  isActive Boolean @default(true)
  note     String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       BudgetCategory  @relation(fields: [categoryId], references: [id])
  cashFlowEvents CashFlowEvent[]

  @@unique([tenantId, accountCode])
  @@index([tenantId])
  @@index([categoryId])
}

// "Top Bakiye" — elle girilen banka bakiye fotoğrafı. MVP: TEK hesap,
// TEK para birimi (tenant.baseCurrency) — bkz. plan'daki kapsam notu.
model BankBalance {
  id       String @id
  tenantId String

  asOfDate     DateTime @db.Date
  balanceMinor BigInt // NEGATİF OLABİLİR (kredili mevduat)
  note         String?

  recordedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, asOfDate]) // günde tek fotoğraf — upsert edilir
  @@index([tenantId])
}

// Gerçekleşen banka hareketi (elle veya Excel ile — Faz 4.3).
model BankTransaction {
  id       String @id
  tenantId String

  valueDate   DateTime          @db.Date // valör
  direction   CashFlowDirection
  amountMinor BigInt // HER ZAMAN pozitif

  description  String
  counterparty String?
  externalRef  String? // banka referans no — mükerrer içe aktarımı engeller

  // --- MUTABAKAT (RECONCILIATION) ---
  // FK TEK YÖNLÜDÜR ve BURADADIR. CashFlowEvent karşı ilişkiyi Prisma'dan
  // bedavaya alır. @unique = bir tahmin en fazla BİR banka hareketiyle
  // eşleşebilir (1:1). Kısmi/bölünmüş eşleşme MVP dışıdır.
  matchedEventId  String?   @unique
  matchedAt       DateTime?
  matchedByUserId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchedEvent CashFlowEvent? @relation(fields: [matchedEventId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalRef])
  @@index([tenantId])
  @@index([tenantId, valueDate])
  @@index([tenantId, matchedEventId])
}
