# Bu dosyayı ".env.local" olarak kopyalayıp değerleri doldurun.
# .env.local git'e gönderilmez.

NODE_ENV=development

# --- PostgreSQL ---
# Üç ayrı rol/bağlantı KASITLI (bkz. prisma/migrations/*_enable_rls/migration.sql):
# superuser/owner bağlantısı RLS'i HER ZAMAN atlar, bu yüzden uygulama çalışma
# zamanı ayrı, RLS'e tabi bir rol kullanmak ZORUNDA.
#
# DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/fpa?schema=public"
# APP_DATABASE_URL="postgresql://kullanici_app:sifre@localhost:5432/fpa?schema=public"
# DATABASE_URL_BYPASS_RLS="postgresql://kullanici_bypass_rls:sifre@localhost:5432/fpa?schema=public"

# Redis (kuyruk ve önbellek eklendiğinde zorunlu olacak)
# REDIS_URL="redis://localhost:6379"
